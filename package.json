{
  "name": "macroads-stock",
  "version": "0.1.0",
  "private": true,
  "description": "Stock management for Macroads — replaces the hand-filled Excel workbook.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "build:vercel": "tsx scripts/vercel-build.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests --max-warnings 0",
    "test:unit": "vitest run",
    "test:db": "node scripts/run-db-tests.mjs",
    "test:e2e": "node scripts/run-e2e.mjs",
    "pin:reset": "tsx scripts/pin-reset.ts",
    "seed:workbook": "tsx scripts/seed-workbook.ts",
    "db:census": "tsx scripts/db-census.ts",
    "db:export": "tsx scripts/db-export.ts",
    "db:restore": "tsx scripts/db-restore.ts",
    "operator:production": "node scripts/operator-production.mjs",
    "verify:deploy": "tsx scripts/verify-deployment.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "exceljs": "4.4.0",
    "next": "15.5.25",
    "next-auth": "5.0.0-beta.32",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@playwright/test": "1.59.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.25",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
