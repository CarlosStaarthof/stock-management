# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# Neon gives you both of these from the Connect dialog, by toggling "Connection pooling".
# Use the dev branch locally; the production branch is set in the Vercel dashboard.

# Pooled - host contains "-pooler". Used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-west-2.aws.neon.tech/neondb?sslmode=require"

# Unpooled - no "-pooler". Used by `prisma migrate`, which fails through the pooler.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.eu-west-2.aws.neon.tech/neondb?sslmode=require"

# Auth.js - generate with: npx auth secret
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
