# .env.example — copy to .env and fill in. NEVER commit .env.
#
# .env is gitignored and is denied to AI agents by .claude/settings.json.
# Nothing in this repository — no script, no test, no documented step — may require
# an agent to read it.

# ---------------------------------------------------------------- database (Neon)
#
# Two connection strings, and the difference matters:
#
#   DATABASE_URL  the POOLED connection. Its host contains "-pooler". This is what
#                 the application uses at runtime; Neon's pooler is what lets a
#                 serverless deployment open many short-lived connections.
#   DIRECT_URL    the UNPOOLED (direct) connection to the same database. Prisma
#                 migrations use DIRECT_URL, because `prisma migrate` fails through
#                 a pooler — it needs a session-level connection to take advisory
#                 locks and run DDL.
#
# Copy both from the Neon dashboard: the pooled string into DATABASE_URL, the direct
# one into DIRECT_URL. Use the "dev" branch locally and the "main" branch in
# production. The values below are PLACEHOLDERS, not a real host.

DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.example.invalid/DATABASE?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.example.invalid/DATABASE?sslmode=require"

# ------------------------------------------------------------------------- auth
#
# Not used yet — authentication is feature #3 auth_and_roles. The variables are
# declared here so the shape of the environment is settled once.
#
# AUTH_SECRET signs the session cookie. Generate your own, per environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# AUTH_URL is the public origin of the deployment.

AUTH_SECRET="REPLACE_WITH_A_GENERATED_SECRET"
AUTH_URL="http://localhost:3000"
