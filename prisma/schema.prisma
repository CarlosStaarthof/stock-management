// Macroads Stock — database schema.
//
// This file is specs/domain-model.md Part 3, field for field, and nothing else: nine
// models and three enums. Drift from Part 3 turns tests/unit/schema-and-migration.test.ts
// red (spec 004 AC-1 and AC-4).
//
// Feature #3 auth_and_roles owns the `Role` enum and the `User` model, plus the
// repository's first migration. Feature #4 domain_schema owns every other declaration
// here, plus the second migration. `User` gains three RELATION fields from #4 and no
// columns — the foreign keys live on `StockCount` (004 AC-5).
//
// Deferred to M7 and absent on purpose: `Vehicle`, `BoilerReading`, `BagReading`,
// `YardBulkReading`, `BoilerMaterial`, `BagMaterial`.
//
// Two URLs, and the difference is load-bearing:
//   DATABASE_URL  Neon's POOLED connection (host contains "-pooler") — used at runtime.
//   DIRECT_URL    the unpooled connection — used by `prisma migrate`, which fails
//                 through a pooler.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// The two roles of specs/domain-model.md Part 6. There is no third role and no
/// yard-scoped user: YARD_STAFF counts and never sees a euro, ADMIN approves and prices.
enum Role {
  YARD_STAFF
  ADMIN
}

/// The count lifecycle of specs/domain-model.md Part 3. Which transitions are legal, and
/// who may make them, is #7's and #9's rule and not the schema's: Postgres holds the
/// value, a service decides who may move it.
enum CountStatus {
  DRAFT
  SUBMITTED
  APPROVED
}

/// What a quantity counts. Derived from `unitLabel` at import (Part 2). `UNIT` is the
/// default because a bare number with no label is a count of things; `Item.needsReview`
/// is how the rows whose label was never understood get looked at again.
enum UnitKind {
  TONNE
  KILOGRAM
  LITRE
  UNIT
  LINEAR_METRE
}

/// An account. `passwordHash` is a bcrypt hash written by src/server/auth/password.ts;
/// the plaintext is never stored, logged or returned.
///
/// `active` is read on every authenticated request rather than trusted from the session
/// token, so deactivating a leaver locks them out on their very next request.
///
/// The three `StockCount[]` fields are relation fields, not columns: they add nothing to
/// the `User` table, and the migration that introduced them emits no ALTER TABLE "User".
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(YARD_STAFF)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  stockCountsCreated  StockCount[] @relation("StockCountCreatedBy")
  stockCountsApproved StockCount[] @relation("StockCountApprovedBy")
  stockCountsSigned   StockCount[] @relation("StockCountSignedBy")
}

/// A yard. A closed set of two, fixed by specs/product-brief.md and written by this
/// feature's migration with the literal ids `loc_dublin` and `loc_clonmel`, because
/// Invariant 7 — a period is complete only when every `active` Location has an APPROVED
/// count — is undefined for as long as the table is empty.
model Location {
  id        String  @id @default(cuid())
  code      String  @unique
  name      String
  active    Boolean @default(true)
  sortOrder Int     @default(0)

  itemLinks   ItemLocation[]
  stockCounts StockCount[]
}

/// Who supplies an item. Archived with `active = false` and never deleted: every foreign
/// key that points here is Restrict.
model Supplier {
  id     String  @id @default(cuid())
  name   String  @unique
  active Boolean @default(true)

  items Item[]
}

/// The item categories of specs/domain-model.md Part 2. `sortOrder` is the order the
/// groups appear in down the yard sheet, which is the order staff read.
model ItemType {
  id        String @id @default(cuid())
  code      String @unique
  name      String
  sortOrder Int    @default(0)

  items Item[]
}

/// A stock item. Its identity is `(description, supplierId)` — the same description under
/// Kestrel and under Kelly is two real items, not a duplicate.
///
/// `supplierId` is nullable because Dublin!A45 has no supplier in the workbook. Postgres
/// treats NULLs as distinct, so that unique pair does not de-duplicate supplier-less rows;
/// preventing a duplicate there is #5's job (spec 004 AC-15).
///
/// `description` also carries a hand-written CHECK, `Item_description_not_empty`: NOT NULL
/// alone lets '' and '   ' through, and Invariant 9 says non-empty.
model Item {
  id             String   @id @default(cuid())
  description    String
  supplierId     String?
  itemTypeId     String
  unitLabel      String?
  unitKind       UnitKind @default(UNIT)
  unitQuantityKg Decimal? @db.Decimal(12, 4)
  active         Boolean  @default(true)
  needsReview    Boolean  @default(false)
  notes          String?

  supplier  Supplier?        @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  itemType  ItemType         @relation(fields: [itemTypeId], references: [id], onDelete: Restrict)
  prices    ItemPrice[]
  locations ItemLocation[]
  lines     StockCountLine[]

  @@unique([description, supplierId])
  @@index([itemTypeId])
  @@index([supplierId])
}

/// A price-list entry. Versioned by `effectiveFrom`, never overwritten (Part 2).
///
/// Decimal(18, 8) and not (12, 4): four Clonmel prices are workbook formulas — `=5.2/0.85`
/// and friends — that do not terminate in decimal, and at four places the totals drift
/// from the file this application replaces (Invariant 10).
model ItemPrice {
  id            String   @id @default(cuid())
  itemId        String
  unitPrice     Decimal  @db.Decimal(18, 8)
  currency      String   @default("EUR")
  effectiveFrom DateTime @db.Date
  label         String?
  createdAt     DateTime @default(now())

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, effectiveFrom])
}

/// Which yard an item is counted at, and where it sits on that yard's sheet.
model ItemLocation {
  id         String  @id @default(cuid())
  itemId     String
  locationId String
  sortOrder  Int     @default(0)
  active     Boolean @default(true)

  item     Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@unique([itemId, locationId])
  @@index([locationId, sortOrder])
}

/// One count, for one yard, for one MONTH — not one day (Invariant 6, Part 4).
/// `countDate` is the day the yard was actually walked; `(periodYear, periodMonth)` is the
/// month the count closes, and `periodMonth` carries a hand-written CHECK of 1..12.
///
/// `signatureSvg` holds SVG path data rather than a raster: a few hundred bytes that scale
/// onto the Excel export and a printed sheet without going fuzzy (Invariant 11).
model StockCount {
  id           String      @id @default(cuid())
  locationId   String
  periodYear   Int
  periodMonth  Int
  countDate    DateTime    @db.Date
  status       CountStatus @default(DRAFT)
  createdById  String
  submittedAt  DateTime?
  approvedById String?
  approvedAt   DateTime?
  notes        String?
  signedById   String?
  signedAt     DateTime?
  signatureSvg String?

  location   Location         @relation(fields: [locationId], references: [id], onDelete: Restrict)
  createdBy  User             @relation("StockCountCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy User?            @relation("StockCountApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  signedBy   User?            @relation("StockCountSignedBy", fields: [signedById], references: [id], onDelete: Restrict)
  lines      StockCountLine[]

  @@unique([locationId, periodYear, periodMonth])
  @@index([periodYear, periodMonth])
  @@index([createdById])
  @@index([approvedById])
  @@index([signedById])
}

/// One line per item per count.
///
/// `quantity` is nullable and that is the whole point: NULL means nobody looked, 0 means
/// counted and none held. The workbook's blank cell could not tell those apart, and
/// Invariant 5 makes a null quantity block submission.
///
/// `unitPriceSnapshot` is null while DRAFT and written once, at submit (Invariant 2). It
/// is a historical fact, not a derived value — and `value` is never a column at all
/// (Invariant 1): it is `quantity * unitPriceSnapshot`, computed on every read.
model StockCountLine {
  id                String   @id @default(cuid())
  stockCountId      String
  itemId            String
  quantity          Decimal? @db.Decimal(12, 4)
  unitPriceSnapshot Decimal? @db.Decimal(18, 8)
  note              String?

  stockCount StockCount @relation(fields: [stockCountId], references: [id], onDelete: Cascade)
  item       Item       @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@unique([stockCountId, itemId])
  @@index([itemId])
}
